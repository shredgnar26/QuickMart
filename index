    <!-- STEP 5 -->
    <div class="panel" data-panel="4">
      <h3>Legal & authorization</h3>
      <p class="hint">Read the terms, then sign by typing your full legal name.</p>
      <div class="grid">
        <div class="full"><label>Have you been convicted of, or pleaded "no contest" to, a crime other than a traffic violation? <span class="req">*</span></label>
          <div class="radio"><label><input type="radio" name="conviction" value="No" required> No</label><label><input type="radio" name="conviction" value="Yes"> Yes</label></div>
