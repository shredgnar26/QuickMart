<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quick Mart — Fuel Wholesale & Convenience Stores | Arkansas</title>
<meta name="description" content="Quick Mart supplies wholesale fuel to dealers and fleets across Arkansas and runs neighborhood convenience stores. Apply online or reach the wholesale desk.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700;800&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --asphalt:#15181C; --slate:#4A5058; --concrete:#ECEBE6; --paper:#FFFFFF;
    --signal:#D8221F; --amber:#F2A900; --line:#D5D3CC;
    --display:'Barlow Condensed',Impact,sans-serif; --body:'Barlow',system-ui,sans-serif; --mono:'IBM Plex Mono',monospace;
    --max:1180px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto} *{animation:none!important;transition:none!important}}
  body{font-family:var(--body);color:var(--asphalt);background:var(--paper);line-height:1.5;font-size:17px}
  a{color:inherit}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
  h1,h2,h3{font-family:var(--display);line-height:1;letter-spacing:.005em;text-transform:uppercase}
  h1{font-size:clamp(52px,8vw,108px);font-weight:800}
  h2{font-size:clamp(36px,5vw,64px);font-weight:800}
  h3{font-size:26px;font-weight:700}
  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--signal);font-weight:600}
  .lede{font-size:19px;color:var(--slate);max-width:56ch}
  :focus-visible{outline:3px solid var(--amber);outline-offset:3px}

  /* Top bar */
  .topbar{background:var(--asphalt);color:#fff;font-size:14px}
  .topbar .wrap{display:flex;justify-content:space-between;align-items:center;height:36px;gap:16px}
  .topbar a{text-decoration:none;color:#cfd2d6}
  .topbar a:hover{color:#fff}
  header.nav{position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:1px solid var(--line)}
  header.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:72px}
  .logo{display:flex;align-items:center;gap:12px;text-decoration:none}
  .logo .mark{width:38px;height:38px;background:var(--signal);clip-path:polygon(0 0,100% 0,100% 70%,50% 100%,0 70%)}
  .logo b{font-family:var(--display);font-size:30px;font-weight:800;text-transform:uppercase;letter-spacing:.02em}
  nav ul{display:flex;gap:28px;list-style:none}
  nav a{text-decoration:none;font-weight:600;font-size:15px;text-transform:uppercase;letter-spacing:.06em}
  nav a:hover{color:var(--signal)}
  .btn{display:inline-block;background:var(--signal);color:#fff;text-decoration:none;font-family:var(--display);font-size:20px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:12px 22px;border:0;cursor:pointer}
  .btn:hover{background:#b31a17}
  .btn.ghost{background:transparent;color:var(--asphalt);border:2px solid var(--asphalt)}
  .btn.ghost:hover{background:var(--asphalt);color:#fff}
  .menu-toggle{display:none;background:none;border:0;font-size:28px;cursor:pointer}
  @media(max-width:860px){nav ul{display:none} .menu-toggle{display:block} nav.open ul{display:flex;flex-direction:column;position:absolute;left:0;right:0;top:72px;background:#fff;padding:20px 24px;border-bottom:1px solid var(--line)}}

  /* Hero */
  .hero{background:var(--concrete);border-bottom:6px solid var(--signal)}
  .hero .wrap{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center;padding:72px 24px}
  .hero p.lede{margin:22px 0 32px}
  .hero .actions{display:flex;gap:14px;flex-wrap:wrap}
  /* Price board — the signature */
  .board{background:var(--asphalt);padding:22px;border:6px solid #2b3036;box-shadow:0 30px 60px -30px rgba(0,0,0,.6)}
  .board .brand{font-family:var(--display);color:#fff;font-size:34px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;border-bottom:2px solid #2b3036;padding-bottom:10px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:baseline}
  .board .brand small{font-family:var(--mono);font-size:11px;color:#9aa0a6;letter-spacing:.14em}
  .board .row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px dashed #2b3036}
  .board .row:last-child{border-bottom:0}
  .board .grade{font-family:var(--display);color:#fff;font-size:26px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
  .board .grade span{display:block;font-family:var(--mono);font-size:11px;color:#9aa0a6;letter-spacing:.12em;font-weight:500}
  .board .price{font-family:var(--mono);font-size:44px;font-weight:600;color:var(--amber);text-shadow:0 0 14px rgba(242,169,0,.55);letter-spacing:.04em}
  .board .price sup{font-size:18px;vertical-align:top;margin-left:2px}
  .board .foot{font-family:var(--mono);font-size:11px;color:#9aa0a6;letter-spacing:.1em;margin-top:12px;text-align:right}
  @media(max-width:860px){.hero .wrap{grid-template-columns:1fr;padding:48px 24px}}

  /* Two lanes */
  section{padding:88px 0}
  .lanes{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line)}
  .lane{padding:44px;border-right:1px solid var(--line)}
  .lane:last-child{border-right:0}
  .lane h3{margin:10px 0 14px;font-size:34px}
  .lane ul{margin:18px 0 26px 18px;color:var(--slate)}
  .lane li{margin-bottom:6px}
  @media(max-width:860px){.lanes{grid-template-columns:1fr}.lane{border-right:0;border-bottom:1px solid var(--line)}}

  /* Stores */
  .stores{background:var(--asphalt);color:#fff}
  .stores .eyebrow{color:var(--amber)}
  .stores .lede{color:#b9bec4}
  .store-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;margin-top:36px}
  .store{border:1px solid #2b3036;padding:22px}
  .store b{font-family:var(--display);font-size:24px;text-transform:uppercase;display:block;margin-bottom:4px}
  .store p{color:#b9bec4;font-size:15px}
  .store .tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
  .store .tags span{font-family:var(--mono);font-size:11px;letter-spacing:.1em;border:1px solid #3a4048;padding:3px 8px;color:#dfe2e6}

  /* Careers */
  .careers-head{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end;margin-bottom:40px}
  @media(max-width:860px){.careers-head{grid-template-columns:1fr}}
  .form-shell{border:1px solid var(--line);background:var(--paper)}
  .steps{display:flex;border-bottom:1px solid var(--line);overflow-x:auto}
  .steps button{flex:1;min-width:130px;background:var(--concrete);border:0;border-right:1px solid var(--line);padding:14px 10px;font-family:var(--display);font-size:17px;text-transform:uppercase;letter-spacing:.05em;color:var(--slate);cursor:pointer}
  .steps button[aria-current="step"]{background:#fff;color:var(--asphalt);box-shadow:inset 0 -4px 0 var(--signal)}
  .steps button.done{color:var(--asphalt)}
  .panel{display:none;padding:36px}
  .panel.active{display:block}
  .panel h3{margin-bottom:6px}
  .panel .hint{color:var(--slate);font-size:15px;margin-bottom:26px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 22px}
  .grid .full{grid-column:1/-1}
  @media(max-width:700px){.grid{grid-template-columns:1fr}}
  label{display:block;font-weight:600;font-size:14px;margin-bottom:6px}
  label .req{color:var(--signal)}
  input[type=text],input[type=email],input[type=tel],input[type=date],select,textarea{width:100%;font:inherit;font-size:16px;padding:11px 12px;border:1px solid #b8b6ae;background:#fff;border-radius:0}
  input:focus,select:focus,textarea:focus{border-color:var(--asphalt)}
  textarea{min-height:96px;resize:vertical}
  .radio{display:flex;gap:18px;flex-wrap:wrap;font-size:15px;font-weight:500}
  .radio label{display:flex;align-items:center;gap:6px;font-weight:500;margin:0}
  fieldset{border:1px solid var(--line);padding:18px;margin-top:8px}
  legend{font-family:var(--display);font-size:20px;text-transform:uppercase;padding:0 8px;letter-spacing:.04em}
  .employer{margin-bottom:18px}
  .terms{background:var(--concrete);padding:18px;font-size:14px;color:var(--slate);max-height:220px;overflow:auto;border:1px solid var(--line)}
  .terms p{margin-bottom:10px}
  .check{display:flex;gap:10px;align-items:flex-start;font-size:15px;margin-top:16px}
  .check input{margin-top:4px;width:18px;height:18px}
  .signature{font-family:'Brush Script MT','Segoe Script',cursive;font-size:30px;border-bottom:2px solid var(--asphalt);min-height:44px;padding:4px 8px;margin-top:8px;color:var(--asphalt)}
  .panel-nav{display:flex;justify-content:space-between;gap:12px;margin-top:32px;padding-top:24px;border-top:1px solid var(--line)}
  .err{color:var(--signal);font-size:14px;margin-top:12px;display:none}
  .err.show{display:block}
  .review dl{display:grid;grid-template-columns:220px 1fr;gap:8px 16px;font-size:15px}
  .review dt{font-weight:600;color:var(--slate)}
  .review dd{word-break:break-word}
  .review h4{font-family:var(--display);text-transform:uppercase;font-size:20px;margin:22px 0 8px;letter-spacing:.04em}
  .status{padding:22px;border-left:6px solid var(--amber);background:var(--concrete);margin-top:20px;font-size:15px}
  .status.ok{border-color:#2f9e44}
  .status.bad{border-color:var(--signal)}
  .status code{font-family:var(--mono);font-size:12px;word-break:break-all}

  /* Resources */
  .resources{background:var(--concrete)}
  .res-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:36px}
  @media(max-width:860px){.res-grid{grid-template-columns:1fr}}
  .card{background:#fff;border:1px solid var(--line);padding:28px}
  .card h3{margin-bottom:14px}
  .list{list-style:none}
  .list li{border-top:1px solid var(--line);padding:12px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:15px}
  .list li:first-child{border-top:0}
  .list a{font-weight:600;text-decoration:none;color:var(--signal)}
  .list small{font-family:var(--mono);font-size:11px;color:var(--slate);letter-spacing:.08em}
  .pdf-embed{margin-top:28px;border:1px solid var(--line);background:#fff}
  .pdf-embed iframe{width:100%;height:640px;border:0;display:block}
  .pdf-embed .bar{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line);font-size:14px}

  /* Contact / footer */
  .contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px}
  @media(max-width:860px){.contact .wrap{grid-template-columns:1fr}}
  .contact dl{display:grid;grid-template-columns:150px 1fr;gap:10px 16px;margin-top:24px;font-size:16px}
  .contact dt{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--slate);padding-top:4px}
  footer{background:var(--asphalt);color:#9aa0a6;padding:36px 0;font-size:14px}
  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
  footer a{color:#cfd2d6;text-decoration:none;margin-left:18px}

  /* Manager decrypt tool */
  #manager{display:none}
  #manager.active{display:block}
  #manager textarea{font-family:var(--mono);font-size:13px;min-height:160px}
  .kv{font-family:var(--mono);font-size:13px;white-space:pre-wrap;background:var(--concrete);padding:18px;border:1px solid var(--line);margin-top:16px;max-height:600px;overflow:auto}
</style>
</head>
<body>

<div class="topbar"><div class="wrap">
  <span>Wholesale fuel desk: <a href="tel:+15010000000">(501) 000-0000</a> · Mon–Fri 7am–5pm</span>
  <span><a href="#resources">Employee resources</a></span>
</div></div>

<header class="nav"><div class="wrap">
  <a class="logo" href="#top" aria-label="Quick Mart home"><span class="mark" aria-hidden="true"></span><b>Quick Mart</b></a>
  <nav id="nav" aria-label="Primary">
    <button class="menu-toggle" aria-label="Open menu" onclick="document.getElementById('nav').classList.toggle('open')">☰</button>
    <ul>
      <li><a href="#wholesale">Wholesale</a></li>
      <li><a href="#stores">Stores</a></li>
      <li><a href="#careers">Careers</a></li>
      <li><a href="#resources">Resources</a></li>
      <li><a href="#contact">Contact</a></li>
      <li><a class="btn" href="#apply" style="font-size:16px;padding:8px 14px">Apply now</a></li>
    </ul>
  </nav>
</div></header>

<main id="top">

<!-- HERO -->
<section class="hero"><div class="wrap">
  <div>
    <span class="eyebrow">Arkansas · Fuel wholesale & retail</span>
    <h1>Fuel for the road<br>and for the trade.</h1>
    <p class="lede">Quick Mart supplies branded and unbranded fuel to dealers, fleets, and farms across Arkansas — and runs the neighborhood stores where the coffee is hot and the bathrooms are clean.</p>
    <div class="actions">
      <a class="btn" href="#wholesale">Get a wholesale quote</a>
      <a class="btn ghost" href="#stores">Find a store</a>
    </div>
  </div>
  <div class="board" role="img" aria-label="Today's posted fuel prices">
    <div class="brand">Quick Mart <small>POSTED TODAY</small></div>
    <div class="row"><div class="grade">Regular <span>87 OCTANE</span></div><div class="price" data-price="2.79">2.79<sup>9</sup></div></div>
    <div class="row"><div class="grade">Plus <span>89 OCTANE</span></div><div class="price" data-price="3.09">3.09<sup>9</sup></div></div>
    <div class="row"><div class="grade">Premium <span>93 OCTANE</span></div><div class="price" data-price="3.39">3.39<sup>9</sup></div></div>
    <div class="row"><div class="grade">Diesel <span>ULTRA LOW SULFUR</span></div><div class="price" data-price="3.19">3.19<sup>9</sup></div></div>
    <div class="foot">SAMPLE PRICES · EDIT IN SITE ADMIN</div>
  </div>
</div></section>

<!-- WHOLESALE / RETAIL -->
<section id="wholesale"><div class="wrap">
  <span class="eyebrow">Two sides of one business</span>
  <h2>Supply the pump. Run the store.</h2>
  <div class="lanes" style="margin-top:36px">
    <div class="lane">
      <span class="eyebrow">Wholesale</span>
      <h3>Fuel supply for dealers, fleets & farms</h3>
      <p class="lede" style="font-size:17px">Consistent deliveries, competitive rack pricing, and a dispatcher who answers the phone.</p>
      <ul>
        <li>Gasoline (all grades) and ultra-low-sulfur diesel</li>
        <li>Off-road diesel and farm accounts</li>
        <li>Transport and tank-wagon delivery</li>
        <li>Branded and unbranded supply options</li>
        <li>Tank stick verification on every drop</li>
      </ul>
      <a class="btn" href="#contact">Request a quote</a>
    </div>
    <div class="lane">
      <span class="eyebrow">Retail</span>
      <h3>Convenience stores built around the daily stop</h3>
      <p class="lede" style="font-size:17px">Fresh deli, fountain drinks, coffee before sunrise, and lottery when you're feeling lucky.</p>
      <ul>
        <li>Hot deli and daily specials</li>
        <li>Fountain, coffee, and cappuccino bar</li>
        <li>Arkansas Scholarship Lottery retailer</li>
        <li>ATM and clean, stocked restrooms</li>
        <li>24-hour locations available</li>
      </ul>
      <a class="btn ghost" href="#stores">See locations</a>
    </div>
  </div>
</div></section>

<!-- STORES -->
<section id="stores" class="stores"><div class="wrap">
  <span class="eyebrow">Locations</span>
  <h2>Find a Quick Mart</h2>
  <p class="lede">Replace the cards below with your actual store addresses, hours, and services.</p>
  <div class="store-grid">
    <div class="store"><b>Store #1 — Name</b><p>123 Main St, City, AR 72000<br>Open 24 hours</p><div class="tags"><span>DELI</span><span>DIESEL</span><span>LOTTERY</span><span>ATM</span></div></div>
    <div class="store"><b>Store #2 — Name</b><p>456 Highway 65, City, AR 72000<br>5am – 11pm</p><div class="tags"><span>DELI</span><span>BEER</span><span>LOTTERY</span></div></div>
    <div class="store"><b>Store #3 — Name</b><p>789 County Rd, City, AR 72000<br>6am – 10pm</p><div class="tags"><span>DIESEL</span><span>OFF-ROAD DIESEL</span></div></div>
    <div class="store"><b>Store #4 — Name</b><p>101 Elm St, City, AR 72000<br>Open 24 hours</p><div class="tags"><span>DELI</span><span>LOTTERY</span><span>ATM</span></div></div>
  </div>
</div></section>

<!-- CAREERS -->
<section id="careers"><div class="wrap">
  <div class="careers-head">
    <div>
      <span class="eyebrow">Careers</span>
      <h2>Work a shift<br>that matters.</h2>
    </div>
    <p class="lede">Cashiers, deli, and store management across our Arkansas locations. Fill out the application below on your phone or computer — it takes about 15 minutes. Prefer paper? <a href="Quick_Mart_Employment_Application.pdf">Download the printable application</a>.</p>
  </div>

  <div id="apply" class="form-shell">
    <div class="steps" role="tablist" aria-label="Application steps">
      <button type="button" data-step="0" aria-current="step">1 · About you</button>
      <button type="button" data-step="1">2 · Availability</button>
      <button type="button" data-step="2">3 · References</button>
      <button type="button" data-step="3">4 · Experience</button>
      <button type="button" data-step="4">5 · Legal & sign</button>
      <button type="button" data-step="5">6 · Review & send</button>
    </div>

    <form id="appForm" novalidate>

    <!-- STEP 1 -->
    <div class="panel active" data-panel="0">
      <h3>About you</h3>
      <p class="hint">Fields marked <span style="color:var(--signal)">*</span> are required. Your Social Security number is not collected here — the store manager will collect it in person after a job offer.</p>
      <div class="grid">
        <div><label>Position applying for <span class="req">*</span></label>
          <select name="position" required><option value="">Select…</option><option>Cashier</option><option>Deli / Kitchen</option><option>Overnight Cashier</option><option>Assistant Manager</option><option>Store Manager</option><option>Fuel Delivery / Wholesale</option><option>Other</option></select></div>
        <div><label>Store location <span class="req">*</span></label>
          <select name="store" required><option value="">Select…</option><option>Store #1 — Name</option><option>Store #2 — Name</option><option>Store #3 — Name</option><option>Store #4 — Name</option><option>Any location</option></select></div>
        <div class="full"><label>Full name <span class="req">*</span></label><input type="text" name="fullName" required autocomplete="name"></div>
        <div class="full"><label>Present address (street, city, state, ZIP) <span class="req">*</span></label><input type="text" name="presentAddress" required autocomplete="street-address"></div>
        <div class="full"><label>Permanent address (if different)</label><input type="text" name="permanentAddress"></div>
        <div><label>Mobile phone <span class="req">*</span></label><input type="tel" name="phoneMobile" required autocomplete="tel"></div>
        <div><label>Home / other phone</label><input type="tel" name="phoneOther"></div>
        <div class="full"><label>Email address <span class="req">*</span></label><input type="email" name="email" required autocomplete="email"></div>
      </div>
      <p class="err" id="err0">Complete every required field before continuing.</p>
      <div class="panel-nav"><span></span><button type="button" class="btn" data-next>Continue</button></div>
    </div>

    <!-- STEP 2 -->
    <div class="panel" data-panel="1">
      <h3>Availability</h3>
      <p class="hint">Be honest here — schedules are built from these answers.</p>
      <div class="grid">
        <div class="full"><label>How will you get to work? <span class="req">*</span></label><input type="text" name="transportation" required placeholder="Own car, ride, bus, walk…"></div>
        <div class="full"><label>Are you willing to work any shift, any day? <span class="req">*</span></label>
          <div class="radio"><label><input type="radio" name="anyShift" value="Yes" required> Yes</label><label><input type="radio" name="anyShift" value="No"> No</label></div></div>
        <div class="full"><label>If no, list the shifts or days you cannot work</label><input type="text" name="shiftLimits"></div>
        <div><label>Desired starting pay per hour <span class="req">*</span></label><input type="text" name="desiredPay" required placeholder="$"></div>
        <div><label>Are you at least 18 years old? <span class="req">*</span></label>
          <div class="radio"><label><input type="radio" name="over18" value="Yes" required> Yes</label><label><input type="radio" name="over18" value="No"> No</label></div></div>
        <div class="full"><label>Are you legally authorized to work in the United States? <span class="req">*</span></label>
          <div class="radio"><label><input type="radio" name="workAuth" value="Yes" required> Yes</label><label><input type="radio" name="workAuth" value="No"> No</label></div>
          <p class="hint" style="margin:8px 0 0">Employment eligibility (Form I-9) is verified after a job offer is accepted.</p></div>
      </div>
      <p class="err" id="err1">Complete every required field before continuing.</p>
      <div class="panel-nav"><button type="button" class="btn ghost" data-prev>Back</button><button type="button" class="btn" data-next>Continue</button></div>
    </div>

    <!-- STEP 3 -->
    <div class="panel" data-panel="2">
      <h3>References & education</h3>
      <p class="hint">Three references not related to you. Include a name and a phone number for each.</p>
      <div class="grid">
        <div class="full"><label>Reference 1 <span class="req">*</span></label><input type="text" name="ref1" required placeholder="Name, relationship, phone"></div>
        <div class="full"><label>Reference 2 <span class="req">*</span></label><input type="text" name="ref2" required placeholder="Name, relationship, phone"></div>
        <div class="full"><label>Reference 3 <span class="req">*</span></label><input type="text" name="ref3" required placeholder="Name, relationship, phone"></div>
        <div class="full"><label>Education</label><textarea name="education" placeholder="School, degree or diploma, years attended"></textarea></div>
        <div class="full"><label>Special qualifications, training, skills, or business equipment you can operate</label><textarea name="skills" placeholder="POS systems, food handler card, forklift, deli, cash handling…"></textarea></div>
      </div>
      <p class="err" id="err2">Complete every required field before continuing.</p>
