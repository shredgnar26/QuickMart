<script>
/* ===== CONFIG — the only block the client edits ===== */
const CONFIG = {
  // Preset passphrase agreed with the office. Applications are AES-256-GCM encrypted in the
  // browser with this passphrase before leaving the device. The email carries ciphertext only.
  passphrase: "CHANGE-ME-office-passphrase",
  // Endpoint that emails the encrypted payload to the hiring inbox. Any form backend works
  // (Formspree, Basin, a Cloudflare Worker, an n8n webhook). It must relay the "encrypted" field.
  endpoint: "https://formspree.io/f/YOUR_FORM_ID",
  // Email shown to the applicant as the destination.
  hiringEmail: "careers@quickmart.us"
};

/* ===== Step navigation ===== */
const panels=[...document.querySelectorAll('.panel')], tabs=[...document.querySelectorAll('.steps button')];
let step=0;
function show(n){step=n;panels.forEach((p,i)=>p.classList.toggle('active',i===n));tabs.forEach((t,i)=>{t.toggleAttribute('aria-current',i===n);if(i===n)t.setAttribute('aria-current','step');t.classList.toggle('done',i<n)});if(n===5)renderReview();document.getElementById('apply').scrollIntoView({block:'start'})}
function valid(n){const p=panels[n];let ok=true;const seen={};p.querySelectorAll('[required]').forEach(el=>{if(el.type==='radio'){if(seen[el.name])return;seen[el.name]=1;if(!p.querySelector(`[name="${el.name}"]:checked`))ok=false}else if(el.type==='checkbox'){if(!el.checked)ok=false}else if(!el.value.trim())ok=false;if(el.type==='email'&&el.value&&!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value))ok=false});const e=document.getElementById('err'+n);if(e)e.classList.toggle('show',!ok);return ok}
document.querySelectorAll('[data-next]').forEach(b=>b.onclick=()=>{if(valid(step))show(step+1)});
document.querySelectorAll('[data-prev]').forEach(b=>b.onclick=()=>show(step-1));
tabs.forEach(t=>t.onclick=()=>{const n=+t.dataset.step;if(n<=step||[...Array(n).keys()].every(valid))show(n)});

/* Employer blocks */
const empFields=[['employer','Name of employer','text'],['dates','Dates of employment','text'],['title','Job title','text'],['type','Type of business','text'],['address','Street address, city, state, ZIP','text'],['pay','Starting pay','text'],['desc','Job description','textarea']];
document.getElementById('employers').innerHTML=[1,2,3].map(i=>`<fieldset class="employer"><legend>Employer ${i}${i===1?' (current or most recent)':''}</legend><div class="grid">${empFields.map(([k,l,t])=>`<div class="${k==='desc'||k==='address'?'full':''}"><label>${l}</label>${t==='textarea'?`<textarea name="emp${i}_${k}"></textarea>`:`<input type="text" name="emp${i}_${k}">`}</div>`).join('')}</div></fieldset>`).join('');

/* Signature preview + default date */
const sig=document.querySelector('[name=signature]');sig.addEventListener('input',()=>document.getElementById('sigPreview').textContent=sig.value);
document.querySelector('[name=signDate]').value=new Date().toISOString().slice(0,10);
document.getElementById('yr').textContent=new Date().getFullYear();

/* Collect + review */
const LABELS={position:'Position',store:'Store',fullName:'Full name',presentAddress:'Present address',permanentAddress:'Permanent address',phoneMobile:'Mobile',phoneOther:'Other phone',email:'Email',transportation:'Transportation',anyShift:'Any shift / any day',shiftLimits:'Shift limits',desiredPay:'Desired pay',over18:'18 or older',workAuth:'Authorized to work in US',ref1:'Reference 1',ref2:'Reference 2',ref3:'Reference 3',education:'Education',skills:'Skills',conviction:'Conviction / no contest',convictionDate:'Date',agree:'Agreed to terms',signature:'Signature',signDate:'Signed',eeoc:'EEOC (voluntary)'};
function collect(){const fd=new FormData(document.getElementById('appForm')),o={};for(const[k,v]of fd.entries())o[k]=v;o.agree=document.querySelector('[name=agree]').checked?'Yes':'No';o.submittedAt=new Date().toISOString();o.userAgent=navigator.userAgent;return o}
function renderReview(){const d=collect();let h='<h4>Application</h4><dl>';for(const k in LABELS){if(k==='eeoc')continue;if(d[k])h+=`<dt>${LABELS[k]}</dt><dd>${esc(d[k])}</dd>`}h+='</dl>';for(let i=1;i<=3;i++){if(d[`emp${i}_employer`]){h+=`<h4>Employer ${i}</h4><dl>`;empFields.forEach(([k,l])=>{if(d[`emp${i}_${k}`])h+=`<dt>${l}</dt><dd>${esc(d[`emp${i}_${k}`])}</dd>`});h+='</dl>'}}h+=`<h4>EEOC (voluntary)</h4><dl><dt>Response</dt><dd>${esc(d.eeoc||'Prefer not to answer')}</dd></dl>`;document.getElementById('review').innerHTML=h}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}

/* ===== Encryption (AES-256-GCM, PBKDF2 210k) ===== */
const enc=new TextEncoder(),dec=new TextDecoder();
const b64=b=>btoa(String.fromCharCode(...new Uint8Array(b))),unb64=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function key(pw,salt){const km=await crypto.subtle.importKey('raw',enc.encode(pw),'PBKDF2',false,['deriveKey']);return crypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:210000,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['encrypt','decrypt'])}
async function encrypt(obj,pw){const salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12));const ct=await crypto.subtle.encrypt({name:'AES-GCM',iv},await key(pw,salt),enc.encode(JSON.stringify(obj)));return `QMAPP1.${b64(salt)}.${b64(iv)}.${b64(ct)}`}
async function decrypt(s,pw){const[tag,salt,iv,ct]=s.trim().split('.');if(tag!=='QMAPP1')throw new Error('Not a Quick Mart application block');const pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:unb64(iv)},await key(pw,unb64(salt)),unb64(ct));return JSON.parse(dec.decode(pt))}

/* ===== Submit ===== */
document.getElementById('appForm').addEventListener('submit',async e=>{
  e.preventDefault();if(![0,1,2,3,4].every(valid)){show([0,1,2,3,4].find(n=>!valid(n)));return}
  const st=document.getElementById('sendStatus'),btn=document.getElementById('sendBtn');btn.disabled=true;btn.textContent='Sending…';
  const d=collect();const eeoc=d.eeoc;delete d.eeoc;
  try{
    const encrypted=await encrypt(d,CONFIG.passphrase);
    const eeocEnc=eeoc?await encrypt({eeoc,submittedAt:d.submittedAt},CONFIG.passphrase):'';
    const payload={applicant:d.fullName,position:d.position,store:d.store,_subject:`Application — ${d.fullName} — ${d.position} — ${d.store}`,encrypted,eeoc_encrypted:eeocEnc,note:`Encrypted application. Open at ${location.origin}${location.pathname}#manager with the office password.`};
    const r=await fetch(CONFIG.endpoint,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)});
    if(!r.ok)throw new Error('Endpoint returned '+r.status);
    st.innerHTML=`<div class="status ok"><b>Application sent.</b> ${esc(d.fullName)}, your application for ${esc(d.position)} at ${esc(d.store)} was encrypted and delivered to ${esc(CONFIG.hiringEmail)}. The store manager will contact you at ${esc(d.phoneMobile)}.</div>`;btn.textContent='Sent';
  }catch(err){
    const encrypted=await encrypt(d,CONFIG.passphrase);
    const blob=new Blob([encrypted],{type:'text/plain'}),url=URL.createObjectURL(blob);
    st.innerHTML=`<div class="status bad"><b>Could not reach the hiring inbox.</b> (${esc(err.message)})<br><br><a class="btn ghost" href="${url}" download="quickmart-application-${esc(d.fullName).replace(/\s+/g,'-')}.txt">Download encrypted application</a><br><br>Email the downloaded file to <b>${esc(CONFIG.hiringEmail)}</b>, or bring the printed PDF to the store.</div>`;btn.disabled=false;btn.textContent='Try again';
  }
});

/* ===== Manager tool ===== */
function route(){document.getElementById('manager').classList.toggle('active',location.hash==='#manager')}
addEventListener('hashchange',route);route();
document.getElementById('decryptBtn').onclick=async()=>{const out=document.getElementById('plainOut');out.style.display='block';try{const o=await decrypt(document.getElementById('cipherIn').value,document.getElementById('pwIn').value);out.textContent=Object.entries(o).filter(([k,v])=>v&&k!=='userAgent').map(([k,v])=>`${(LABELS[k]||k).padEnd(28)} ${v}`).join('\n')}catch(e){out.textContent='Could not decrypt. Check the password and that the whole block was pasted.'}};
</script>
