<!-- MANAGER DECRYPT TOOL (open with #manager) -->
<section id="manager"><div class="wrap">
  <span class="eyebrow">Hiring managers only</span>
  <h2>Open an application</h2>
  <p class="lede">Paste the encrypted block from the application email and enter the office password.</p>
  <div class="grid" style="margin-top:24px">
    <div class="full"><label>Encrypted application</label><textarea id="cipherIn"></textarea></div>
    <div><label>Password</label><input type="text" id="pwIn" autocomplete="off"></div>
    <div style="align-self:end"><button type="button" class="btn" id="decryptBtn">Decrypt</button></div>
  </div>
  <div class="kv" id="plainOut" style="display:none"></div>
</div></section>

